# Copy this to .env.local and fill in your values.
#
# Every EXPO_PUBLIC_* var is inlined into the client bundle at build time, so
# each one must ALSO be set in the Vercel project settings for the deployed web
# app -- setting it here only affects your machine. A var that is missing in
# Vercel does not error; the feature just silently degrades in production.
# (That is exactly how the map shipped watermarked: see lib/basemap.ts.)
#
# Corollary: nothing genuinely secret belongs in an EXPO_PUBLIC_ var. Anything
# here is readable by anyone who opens the JS bundle.

# --- Required ---------------------------------------------------------------
# Supabase project (use the gilgameshenterprisellc@gmail.com account)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# CARTO dark basemap key. Free tier: 5M tile requests/month, no approval queue.
# Get one at carto.com. WITHOUT THIS the web map falls back to a plain OSM
# basemap -- and before lib/basemap.ts existed, it rendered every tile stamped
# "API KEY REQUIRED". Must be set in Vercel, not just locally.
EXPO_PUBLIC_CARTO_KEY=your-carto-key-here

# --- Optional ---------------------------------------------------------------
# Mapbox token. Used for geocoding venue addresses and for the satellite
# imagery in the admin polygon-draw tool. Without it, the draw tool falls back
# to Esri imagery and geocoding precision drops.
EXPO_PUBLIC_MAPBOX_TOKEN=your-mapbox-token-here

# Sightengine image moderation for photo-first Pulse. Leave BOTH unset to run in
# free/reactive mode: photos post instantly and rely on report -> auto-hide.
# When set, uploads are screened and obvious NSFW is blocked before posting.
# Note: in the current no-server setup this secret ships in the client bundle.
# That is an accepted tradeoff for a rate-limited free-tier key during beta --
# move it behind a Supabase Edge Function before scale. See lib/moderation.ts.
EXPO_PUBLIC_SIGHTENGINE_USER=
EXPO_PUBLIC_SIGHTENGINE_SECRET=

# Set to "1" to reveal pricing UI. Unset/absent hides it.
EXPO_PUBLIC_SHOW_PRICING=
